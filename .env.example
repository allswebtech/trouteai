# TRouteAI settings. Restart the app after changing this file.

# Dashboard password for the first login (at least 8 characters).
# Empty = a random password is saved in DATA_DIR/initial-admin-password.txt
INITIAL_PASSWORD=

# Port the app listens on.
PORT=20017

# Your public address, for example https://ai.example.com
NEXT_PUBLIC_BASE_URL=http://localhost:20017

# true = apps need an API key from the dashboard to use /v1 (recommended).
REQUIRE_API_KEY=true

# Secret keys. `npm install` fills them in automatically. Keep them private.
JWT_SECRET=
API_KEY_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Data folder (database, logs, backups). Default: ~/.trouteai
# DATA_DIR=/home/youruser/trouteai-data
# Always mark the login cookie as secure. HTTPS is usually detected automatically.
# AUTH_COOKIE_SECURE=true
# Behind a reverse proxy (nginx, Caddy, Cloudflare)? Trust its forwarding
# headers (X-Forwarded-Proto / X-Forwarded-For) so the real client IP and HTTPS
# are detected. Only set this when a trusted proxy sits in front — a direct
# public deployment must leave it off, or those headers become spoofable.
#   loopback = proxy runs on this machine (most setups)   private = proxy on the LAN
# TROUTEAI_TRUST_PROXY=loopback
# The terminal shows only warnings and errors in production. info or debug shows more.
# APP_LOG_LEVEL=info
# App log file: rotate at this size, keep this many old files (defaults: 10M, 3).
# APP_LOG_MAX_FILE_SIZE=10M
# APP_LOG_MAX_FILES=3
# Request detail files (call_logs in the data folder): days to keep and total size cap in MB
# (defaults: 7 days, 300 MB; the oldest files are removed first).
# CALL_LOG_RETENTION_DAYS=7
# CALL_LOG_MAX_TOTAL_MB=300
# Server memory limit in MB (default: 35% of RAM, 512 to 4096). Raise it if the log shows "JavaScript heap out of memory".
# Only the `trouteai` command reads it; npm start / app.cjs use `node --max-old-space-size=N`.
# TROUTEAI_MAX_HEAP_MB=1024
# Credit line in the sidebar and on the login page. Empty = hidden.
# BRAND_CREDIT="Your credit line"
# BRAND_CREDIT_URL=https://your-website.example
