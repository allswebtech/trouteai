{
  "name": "trouteai",
  "version": "1.0.9",
  "description": "Your AI. Your Models. Your Rules. An open-source, self-hosted AI gateway to route, manage, and optimize multiple LLM providers through a single OpenAI- and Anthropic-compatible API.",
  "keywords": [
    "ai",
    "llm",
    "ai-gateway",
    "llm-gateway",
    "ai-router",
    "llm-router",
    "ai-proxy",
    "llm-proxy",
    "openai-proxy",
    "api-gateway",
    "proxy",
    "openai",
    "openai-compatible",
    "anthropic",
    "anthropic-compatible",
    "claude",
    "claude-code",
    "codex",
    "gemini",
    "ollama",
    "model-routing",
    "fallback",
    "load-balancing",
    "usage-limits",
    "multi-provider",
    "self-hosted",
    "dashboard"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allswebtech/trouteai.git"
  },
  "homepage": "https://github.com/allswebtech/trouteai#readme",
  "bugs": {
    "url": "https://github.com/allswebtech/trouteai/issues"
  },
  "type": "module",
  "bin": {
    "trouteai": "bin/trouteai.mjs"
  },
  "files": [
    ".build/next/",
    "!.build/next/cache/",
    "!.build/next/dev/",
    "!.build/next/diagnostics/",
    "!.build/next/node_modules/",
    "!.build/next/types/",
    "!.build/next/trace",
    "!.build/next/trace-build",
    "!.build/next/**/*.map",
    "!.build/next/**/*.nft.json",
    "bin/",
    "config/i18n.json",
    "config/payloadRules.json",
    "open-sse/",
    "public/",
    "scripts/",
    "!scripts/release/",
    "src/",
    "app.cjs",
    "next.config.mjs",
    "tsconfig.json",
    "sixpanel.json",
    ".env.example"
  ],
  "workspaces": [
    "open-sse"
  ],
  "allowScripts": {
    "tls-client-node": true,
    "koffi": true
  },
  "engines": {
    "node": ">=22.22.2 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "node --max-old-space-size=4096 scripts/dev/run-next.mjs dev",
    "build": "node scripts/build/build.mjs",
    "start": "node --max-old-space-size=256 scripts/dev/run-next.mjs start",
    "lint": "eslint . --cache --cache-location .eslintcache --suppressions-location config/quality/eslint-suppressions.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:baseline": "node tests/quality/typecheck-baseline.mjs",
    "test": "sh tests/smoke/run.sh",
    "test:all": "sh tests/all.sh",
    "release": "node scripts/release/publish.mjs",
    "reset-password": "node --env-file-if-exists=.env bin/reset-password.mjs",
    "prepack": "node scripts/build/build.mjs --release",
    "prepare": "node scripts/build/postinstall.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "next": "16.4.5",
    "node-machine-id": "1.1.12",
    "pino": "10.4.0",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.2",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "13.0.3",
    "tls-client-node": "0.2.0",
    "wreq-js": "3.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1164.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lobehub/icons": "^6.15.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@monaco-editor/react": "^4.7.0",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/postcss": "^4.3.5",
    "@toon-format/toon": "^4.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/safe-regex": "^1.1.6",
    "@types/ws": "^8.18.2",
    "@xyflow/react": "^12.12.1",
    "bottleneck": "^2.19.5",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "fetch-socks": "^1.3.3",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^5.5.0",
    "material-symbols": "^0.48.3",
    "monaco-editor": "^0.57.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "parse5": "^8.1.1",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "safe-regex": "^2.1.1",
    "smol-toml": "1.9.1",
    "socks": "^2.8.10",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "undici": "^8.12.4",
    "uuid": "^14.0.3",
    "xxhash-wasm": "^1.1.0",
    "yazl": "^3.3.1",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.10.1",
    "sharp": "^0.35.0",
    "postcss": "^8.5.18",
    "ip-address": "^10.7.5",
    "uuid": "^14.0.3",
    "dompurify": "^3.4.17",
    "minimatch": "^11.0.4"
  }
}
